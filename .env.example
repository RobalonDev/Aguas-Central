# Aplicación NestJS
NODE_ENV=development
PORT=3000

# Inicialización de PostgreSQL mediante Docker Compose.
# Solo se aplican cuando el volumen de datos está vacío.
POSTGRES_USER=house_admin
POSTGRES_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
POSTGRES_DB=house

# Puerto publicado en tu Mac.
# PostgreSQL escucha en el puerto 5432 dentro del contenedor.
POSTGRES_PORT=5432

# Conexión utilizada por node-pg-migrate.
# Esta cuenta puede crear y modificar las tablas.
MIGRATION_DATABASE_URL=postgresql://house_migrator:CHANGE_ME_MIGRATOR_PASSWORD@127.0.0.1:5432/house

# Conexión utilizada por NestJS.
# Esta cuenta puede trabajar con datos, pero no modificar las tablas.
DATABASE_URL=postgresql://house_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:5432/house